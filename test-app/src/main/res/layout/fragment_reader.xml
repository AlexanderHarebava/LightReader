<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:fitsSystemWindows="false"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_reader_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/navigation_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/ThemeReader"
        android:elevation="8dp"

        android:orientation="vertical"
        android:padding="20dp">

        <!-- Название текущей главы -->
        <TextView
            android:id="@+id/chapter_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="" />

        <!-- Процент прогресса -->
        <TextView
            android:id="@+id/page_number_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/textColorSecondary"
            android:textSize="14sp"
            android:text="0%" />

        <!-- Контейнер для SeekBar и маркеров глав -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="4dp">

            <SeekBar
                android:id="@+id/page_seek_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:progressTint="@color/textColorPrimary"
                android:thumbTint="@color/textColorSecondary" />

            <!-- Кастомный View для отрисовки линий глав -->
            <org.readium.r2.testapp.reader.ChapterMarkersView
                android:id="@+id/chapter_markers_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>